{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/glirette/thisstuffiswaytootech/main/schemas/technical-source-candidate.schema.json",
  "title": "Technical public-authority source candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidateId",
    "destination",
    "topicId",
    "title",
    "summary",
    "reviewedAtUtc",
    "recheckBeforeUse",
    "sources",
    "supports",
    "doesNotProve",
    "generatorEvidence"
  ],
  "properties": {
    "schema": { "const": "technical-source-candidate/v1" },
    "candidateId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "destination": { "const": "glirette/thisstuffiswaytootech" },
    "topicId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 },
    "title": { "type": "string", "minLength": 8, "maxLength": 140 },
    "summary": { "type": "string", "minLength": 20, "maxLength": 1200 },
    "reviewedAtUtc": { "type": "string", "format": "date-time" },
    "recheckBeforeUse": { "type": "boolean" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "title", "publisher", "kind", "reviewedAtUtc", "supports"],
        "properties": {
          "url": { "type": "string", "format": "uri", "maxLength": 500 },
          "title": { "type": "string", "minLength": 3, "maxLength": 180 },
          "publisher": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 50 },
          "kind": {
            "enum": ["official_vendor_docs", "official_project_docs", "official_changelog", "standards_body"]
          },
          "reviewedAtUtc": { "type": "string", "format": "date-time" },
          "supports": { "type": "string", "minLength": 10, "maxLength": 500 }
        }
      }
    },
    "supports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 10, "maxLength": 500 }
    },
    "doesNotProve": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 10, "maxLength": 500 }
    },
    "generatorEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "authMode", "model", "runId", "generatedAtUtc", "usage"],
      "properties": {
        "provider": { "const": "openai" },
        "authMode": { "const": "dedicated_public_source_key" },
        "model": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 80 },
        "runId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "maxLength": 120 },
        "generatedAtUtc": { "type": "string", "format": "date-time" },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputTokens", "outputTokens", "reasoningTokens"],
          "properties": {
            "inputTokens": { "type": "integer", "minimum": 0 },
            "outputTokens": { "type": "integer", "minimum": 0 },
            "reasoningTokens": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}

